{
  "manifest_version": 3,
  "name": "PDDIKTI Dosen Scraper",
  "version": "1.0.0",
  "description": "Ekstensi browser untuk mengambil data dosen pada halaman Detail Program Studi PDDIKTI Kemdiktisaintek ke format CSV/Excel atau JSON.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://pddikti.kemdiktisaintek.go.id/*",
    "https://api-pddikti.kemdiktisaintek.go.id/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PDDIKTI Dosen Scraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://pddikti.kemdiktisaintek.go.id/*"
      ],
      "js": [
        "src/network-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pddikti.kemdiktisaintek.go.id/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

